# Template only. Never commit a filled-in copy — `.env` is git-ignored.
# In production every value below is set in the Railway dashboard, not in a file.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# `development` boots a zero-secret, zero-cost graph. `production` enforces the
# startup checks in app/runtime_config.py and refuses to start on a missing or
# placeholder value.
RUNTIME_MODE=development

# ---------------------------------------------------------------------------
# Supabase — use DISTINCT projects for dev and prod (see DEPLOYMENT.md § A4)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Where Supabase returns the user after they click the confirmation email link.
# Must be registered under Supabase Auth -> URL Configuration -> Redirect URLs.
SUPABASE_EMAIL_REDIRECT_URL=http://localhost:3000/auth/confirmed

# ---------------------------------------------------------------------------
# Model identifiers — see DEPLOYMENT.md § Model pinning policy
# ---------------------------------------------------------------------------
# Every id here must appear in REVIEWED_ANTHROPIC_MODELS in app/runtime_config.py.
# Production refuses to start otherwise. Changing a model is a source edit that
# requires re-running the routing and evaluation suites — never an env-only tweak.
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BEHAVIOR_MODEL=claude-sonnet-5
ANTHROPIC_HEALTH_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Per-model pricing, USD per million tokens
# ---------------------------------------------------------------------------
# Production refuses to start until every rate is positive, because the hard
# spend cap is computed from these numbers.
#
# These are the STANDARD list rates, deliberately not the Sonnet 5 introductory
# rates ($2.00 / $10.00, which end 31 August 2026). Configuring standard rates
# keeps the ledger conservative during the introductory period and removes a
# cliff on 1 September. See DEPLOYMENT.md § Pricing.
#
# Cache rates follow the published multipliers on the model's input rate:
#   cache write (5-minute TTL) = 1.25x input      cache read = 0.10x input

# Fast tier — Haiku 4.5 ($1.00 / $5.00)
ANTHROPIC_FAST_INPUT_COST_PER_MILLION_USD=1.00
ANTHROPIC_FAST_OUTPUT_COST_PER_MILLION_USD=5.00
ANTHROPIC_FAST_CACHE_WRITE_COST_PER_MILLION_USD=1.25
ANTHROPIC_FAST_CACHE_READ_COST_PER_MILLION_USD=0.10

# Behavior tier — Sonnet 5 ($3.00 / $15.00)
ANTHROPIC_BEHAVIOR_INPUT_COST_PER_MILLION_USD=3.00
ANTHROPIC_BEHAVIOR_OUTPUT_COST_PER_MILLION_USD=15.00
ANTHROPIC_BEHAVIOR_CACHE_WRITE_COST_PER_MILLION_USD=3.75
ANTHROPIC_BEHAVIOR_CACHE_READ_COST_PER_MILLION_USD=0.30

# Health tier — Sonnet 5 ($3.00 / $15.00). Must match the behavior tier while
# both point at the same model id; the settings validator enforces this.
ANTHROPIC_HEALTH_INPUT_COST_PER_MILLION_USD=3.00
ANTHROPIC_HEALTH_OUTPUT_COST_PER_MILLION_USD=15.00
ANTHROPIC_HEALTH_CACHE_WRITE_COST_PER_MILLION_USD=3.75
ANTHROPIC_HEALTH_CACHE_READ_COST_PER_MILLION_USD=0.30

# ---------------------------------------------------------------------------
# Spend cap
# ---------------------------------------------------------------------------
HARD_SPEND_CAP_USD=10
# `monthly` resets at 00:00 UTC on the first of each month. `lifetime` is the
# old cumulative behavior and will disable model calls permanently once reached.
SPEND_WINDOW=monthly
# Fraction of the cap that emits an approaching-cap WARNING log.
SPEND_WARNING_RATIO=0.8

# ---------------------------------------------------------------------------
# Embeddings and reranking
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

# `local` is the zero-cost development cross-encoder. Production requires
# `hosted`; the startup check rejects `local` under RUNTIME_MODE=production.
RERANKER_MODE=local
RERANKER_URL=http://127.0.0.1:8001/rerank
RERANKER_API_KEY=local-unused
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Production reranker (Cohere):
#   RERANKER_MODE=hosted
#   RERANKER_URL=https://api.cohere.com/v2/rerank
#   RERANKER_API_KEY=<cohere key>
#   RERANKER_MODEL=rerank-v3.5

# ---------------------------------------------------------------------------
# Retrieval shape
# ---------------------------------------------------------------------------
RETRIEVAL_CANDIDATE_POOL_SIZE=40
RETRIEVAL_RERANK_OUTPUT_SIZE=20
RETRIEVAL_FINAL_CONTEXT_SIZE=5
RETRIEVAL_MIN_RERANK_SCORE=0.05

# ---------------------------------------------------------------------------
# Memory and safety thresholds — changing these changes safety behavior
# ---------------------------------------------------------------------------
MEMORY_SUMMARY_MESSAGE_LIMIT=20
MEMORY_RETRIEVAL_LIMIT=5
HEALTH_SIGNAL_THRESHOLD=0.70
HEALTH_SIGNAL_MEDIUM_THRESHOLD=0.40
BEHAVIOR_GROUNDING_MIN_QUERY_COVERAGE=0.65
BEHAVIOR_GROUNDING_MIN_QUERY_TERMS=2

# ---------------------------------------------------------------------------
# HTTP edge
# ---------------------------------------------------------------------------
# Scheme, host, and port only. No trailing slash, path, query, or fragment —
# the startup check rejects anything else. Add the production frontend origin
# here (Railway dashboard) and keep localhost for development.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production example:
#   CORS_ALLOWED_ORIGINS=["https://YOUR_PRODUCTION_DOMAIN","http://localhost:3000"]

# Per-account chat requests per rolling minute. Cost protection, not a security
# control: it stops one account exhausting the shared spend cap.
CHAT_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# `json` for deployed environments, `text` for readable local output.
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Corpus ingestion (local tooling only; the deployed API never reads this)
# ---------------------------------------------------------------------------
CORPUS_SOURCE_DIR="./corpus"
